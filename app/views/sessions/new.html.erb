<h1>ログイン</h1>

<%= form_with url: login_path do |f| %>
  <div class="field">
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email, value: params[:email] %>
  </div>
  <div class="field">
    <%= f.label :password, "パスワード" %>
    <%= f.password_field :password %>
  </div>
  <%= f.submit "ログイン", class: "btn" %>
<% end %>

<p><%= link_to "新規登録はこちら", signup_path %></p>